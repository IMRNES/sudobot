[Unit]
Description=sudobot Discord bot (gateway connection, XP and role engine)
Documentation=https://github.com/IMRNES/sudobot
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=sudobot
Group=sudobot
WorkingDirectory=/opt/sudobot

# A separate unit from the API on purpose: the bot holds a long-lived gateway
# connection and must survive an API redeploy, and a panic in a slash command
# must not take the dashboard down with it. The two processes share one database
# and that is the whole integration surface.
# `--project` is explicit because bws-exec defaults to the OTHER project in
# this Bitwarden organization (orangevps), which would make every fetch
# report 'no secrets with prefix sudobot_' and crash-loop the unit.
ExecStart=/usr/local/bin/bws-exec sudobot --project 4a19cf5f-e92b-4373-ad43-b4e500b8070a /opt/sudobot/current/bin/bot

Restart=always
RestartSec=5
StartLimitIntervalSec=300
StartLimitBurst=5

Environment=RUST_LOG=info

NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sudobot-bot

[Install]
WantedBy=multi-user.target
