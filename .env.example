# ---------------------------------------------------------------------------
# sudobot — copy to `.env` and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
# Comma-separated. Empty in development means "any localhost port".
CORS_ORIGINS=

# --- database --------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/sudobot
DATABASE_MAX_CONNECTIONS=10
DATABASE_MIN_CONNECTIONS=1
DATABASE_ACQUIRE_TIMEOUT=8
DATABASE_IDLE_TIMEOUT=300

# --- api auth (dashboard) --------------------------------------------------
# openssl rand -hex 32
JWT_SECRET=dev-only-secret-replace-me-with-openssl-rand-hex-32
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
WEB_ORIGIN=http://localhost:5173

# --- discord application ---------------------------------------------------
# Developer Portal -> Applications -> OAuth2
#
# Only `identify` is requested, so the redirect URI is the single value that must
# be registered. The guild list is never read through this application: access is
# decided from roles, which needs the bot token below.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must match the Developer Portal entry byte for byte, including any stray space.
DISCORD_REDIRECT_URI=http://localhost:5173/auth/callback

# --- discord bot -----------------------------------------------------------
# Developer Portal -> Bot -> Reset Token
DISCORD_BOT_TOKEN=
# Set to a test guild id for instant slash-command updates; empty = global.
DISCORD_DEV_GUILD_ID=
# Guild whose cosmetic level ladder is created and reconciled when the bot
# connects. Makes the ladder part of the deploy instead of a hand-built step.
DISCORD_PROVISION_GUILD_ID=
# Extra snowflake ids allowed to run owner-only bot commands.
DISCORD_OWNER_IDS=

# --- dashboard access (whitelist) -----------------------------------------
# The dashboard serves exactly one guild. Leaving DASHBOARD_GUILD_ID empty
# disables sign-in entirely rather than opening the dashboard to everyone.
DASHBOARD_GUILD_ID=
# Discord role ids that may open the dashboard, comma-separated. Read with the
# bot token, so the bot needs the Server Members intent.
DASHBOARD_WHITELIST_ROLE_IDS=
# User ids allowed in regardless of roles; for the operator account before any
# role exists. Comma-separated.
DASHBOARD_ALLOWLIST_USER_IDS=

# --- frontend (Vite) -------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080
